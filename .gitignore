# Dependencias
node_modules/

# Reportes generados (cada quien genera los suyos, no se versionan)
reports/

# Interfaz web (Astro) — build local
web/dist/
web/.astro/

# Estado transitorio de auditorías en curso (sí se versiona el historial.json,
# pero no el estado.json de la corrida activa ni la señal de cancelación)
proyectos/*/estado.json
proyectos/*/cancelar.flag

# Logs
*.log
npm-debug.log*
.npm-cache/

# Sistema operativo
.DS_Store
Thumbs.db

# Variables de entorno
.env
.env.local
